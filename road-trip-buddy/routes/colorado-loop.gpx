<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Road Trip Buddy (Astro)" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Colorado Loop — Million Dollar Highway</name>
    <desc>Road Trip Register candidate loop (status: idea, seeded Oct 30, 2026). Ouray → Million Dollar Highway (US 550) over Red Mountain Pass → Silverton → Durango → Mesa Verde → Telluride → Black Canyon of the Gunnison → Ouray. Best window: late spring through fall. Waypoint-level route skeleton — not turn-by-turn navigation.</desc>
    <time>2026-10-30T22:20:00Z</time>
  </metadata>
  <wpt lat="38.02480" lon="-107.67146">
    <name>Ouray, CO</name>
    <desc>"Switzerland of America" — south end of the Million Dollar Highway. Box Canyon Falls, Ouray Hot Springs, Cascade Falls, Ouray Brewery, Switzerland of America lookout, Ouray Ice Park (winter).</desc>
    <sym>Town</sym>
  </wpt>
  <wpt lat="37.90415" lon="-107.70363">
    <ele>3358</ele>
    <name>Red Mountain Pass (11,018 ft)</name>
    <desc>Summit of the Million Dollar Highway (US 550). Shelf road, no guardrails in stretches. Winter is serious mountain driving.</desc>
    <sym>Summit</sym>
  </wpt>
  <wpt lat="37.80528" lon="-107.67104">
    <name>Silverton, CO</name>
    <desc>Historic mining town at the far side of Red Mountain Pass, on US 550.</desc>
    <sym>Town</sym>
  </wpt>
  <wpt lat="37.27365" lon="-107.87921">
    <name>Durango, CO</name>
    <desc>Southern end of US 550 — the end of the Million Dollar Highway.</desc>
    <sym>Town</sym>
  </wpt>
  <wpt lat="37.33137" lon="-108.41623">
    <name>Mesa Verde National Park</name>
    <desc>Loop partner west of Durango.</desc>
    <sym>Park</sym>
  </wpt>
  <wpt lat="37.93816" lon="-107.81118">
    <name>Telluride, CO</name>
    <desc>Loop partner — reached via Ridgway from the Ouray side.</desc>
    <sym>Town</sym>
  </wpt>
  <wpt lat="38.54121" lon="-107.69366">
    <name>Black Canyon of the Gunnison National Park</name>
    <desc>South Rim entrance (CO-347, Montrose). About an hour from Ouray.</desc>
    <sym>Park</sym>
  </wpt>
  <rte>
    <name>Colorado Loop — Million Dollar Highway</name>
    <desc>Waypoint-level loop skeleton in driving order, closing back at Ouray.</desc>
    <rtept lat="38.02480" lon="-107.67146"><name>Ouray, CO</name></rtept>
    <rtept lat="37.90415" lon="-107.70363"><name>Red Mountain Pass (11,018 ft)</name></rtept>
    <rtept lat="37.80528" lon="-107.67104"><name>Silverton, CO</name></rtept>
    <rtept lat="37.27365" lon="-107.87921"><name>Durango, CO</name></rtept>
    <rtept lat="37.33137" lon="-108.41623"><name>Mesa Verde National Park</name></rtept>
    <rtept lat="37.93816" lon="-107.81118"><name>Telluride, CO</name></rtept>
    <rtept lat="38.54121" lon="-107.69366"><name>Black Canyon of the Gunnison National Park</name></rtept>
    <rtept lat="38.02480" lon="-107.67146"><name>Ouray, CO (loop closes)</name></rtept>
  </rte>
</gpx>
