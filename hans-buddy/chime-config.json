    "appliesTo": "content modules (all except time)",
    "cycleOrder": "config module order",
    "mode": "rotate"
  },
  "configFor": "hans-hourly-chime",
  "delivery": {
    "quietHours": {
      "enabled": true,
      "endHour": 6,
      "note": "Dave's sleep window (set 2026-10-29): runs at 23:00 and 00:00-05:00 are NOT announced in chat. The worker still composes the text couplet for the daily log but skips audio synthesis, and the delivery turn stays silent. First announced chime is 06:00; last is 22:00. Urgent items found overnight surface on the 06:00 run's own fresh check.",
      "startHour": 23
    },
    "target": "main-chat"
  },
