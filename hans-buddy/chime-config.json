    },
    {
      "enabled": false,
      "id": "zen",
      "note": "NEW - one genuine attributed Zen quote; never repeat a quote within 30 days; track used quotes in ~/workspace/astro-chime/state.md."
    },
    {
      "enabled": false,
      "id": "news",
      "note": "NEW - one top headline from a reputable source, with the source named in the line."
    },
    {
      "enabled": false,
      "id": "positiveThought",
      "note": "NEW - one short uplifting thought for the day (secular and warm; distinct from the Zen quote)."
    }
